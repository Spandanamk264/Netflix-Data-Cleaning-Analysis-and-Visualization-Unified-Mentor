# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=netflix_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=True
API_WORKERS=4

# Dashboard Configuration
DASH_HOST=0.0.0.0
DASH_PORT=8050
DASH_DEBUG=True

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Model Configuration
MODEL_DIR=models
RANDOM_SEED=42

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Security
SECRET_KEY=your-secret-key-change-this-in-production
API_RATE_LIMIT=100/minute

# Paths
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
DATA_FEATURES_DIR=data/features
REPORTS_DIR=reports
